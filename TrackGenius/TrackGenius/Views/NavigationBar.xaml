<UserControl x:Class="TrackGenius.UI.Views.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackGenius.UI.Views"
             xmlns:viewModel="clr-namespace:TrackGenius.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="65"
             x:Name="NavPnl"
             Width="65"
             d:DataContext="{d:DesignInstance Type=viewModel:NavigationBarViewModel}">
    <Grid Background="RoyalBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ToggleButton x:Name="Tg_Btn"
                      Grid.Row="0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Height="60"
                      Width="65"
                      Content="三">

            <!--// Toggle Button - Checked, Unchecked events //-->
            <ToggleButton.Triggers>
                <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                    <BeginStoryboard>
                        <Storyboard x:Name="HideStackPanel">
                            <DoubleAnimation
                                Storyboard.TargetName="NavPnl"
                                Storyboard.TargetProperty="Width"
                                BeginTime="0:0:0"
                                From="230" To="65"
                                Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="ToggleButton.Checked">
                    <BeginStoryboard>
                        <Storyboard x:Name="ShowStackPanel">
                            <DoubleAnimation
                                Storyboard.TargetName="NavPnl"
                                Storyboard.TargetProperty="Width"
                                BeginTime="0:0:0"
                                From="65" To="230"
                                Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ToggleButton.Triggers>
        </ToggleButton>

        <ListView ItemsSource="{Binding NavigationItems}"
                  Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModel:NavigationItem}">
                    <StackPanel>
                        <Image Source="{Binding ItemIcon}"
                               Width="32" Height="32"/>

                        <TextBlock Text="{Binding Title}"/>

                        <ToolTip Content="{Binding Tip}"/>
                    </StackPanel>
                </DataTemplate>

            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>