<ui:FluentWindow x:Class="TrackGenius.UI.MainForm"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModel="clr-namespace:TrackGenius.UI.ViewModels"
                 xmlns:commands="clr-namespace:TrackGenius.UI.Commands"
                 xmlns:pages="clr-namespace:TrackGenius.UI.Pages"
                 mc:Ignorable="d"
                 Title="Track Genius"
                 Height="450" Width="800"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static commands:CustomCommands.StartRaceCommand}"
                        CanExecute="StartRace_OnCanExecute"
                        Executed="StartRace_OnExecuted" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" HorizontalAlignment="Stretch"
                     Height="30">

            <ui:TitleBar.CenterContent>
                <StackPanel Margin="20, 0, 0, 0" 
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                    
                    <TextBlock Text="Track Genius"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.CenterContent>

            <ui:TitleBar.TrailingContent >
                <TextBlock Text="v1.0.0"
                           VerticalAlignment="Center"
                           Margin="0, 0, 10, 0" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>


        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="200"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.PaneHeader>
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <Grid Height="44"
                          HorizontalAlignment="Stretch"
                          ClipToBounds="True">
                        <Image Source="/Resources/TraceGeniusLogo.png"
                               Width="{Binding ElementName=RootNavigation, Path=OpenPaneLength}"
                               Height="44"
                               HorizontalAlignment="Left"
                               Stretch="Fill" />
                    </Grid>

                    <Button Width="36"
                            Height="36"
                            Margin="3,8,0,8"
                            HorizontalAlignment="Left"
                            Click="TogglePane_OnClick"
                            BorderThickness="0"
                            Padding="0"
                            Background="Transparent"
                            Content="&#9776;" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Quick Race"
                                       TargetPageType="{x:Type pages:QuickRacePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Flag24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"
                                       TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <StatusBar Grid.Row="2" Height="60" Padding="10, 0 10,0">
            <StackPanel VerticalAlignment="Center">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                    Margin="5"
                                    Content="{ui:SymbolIcon SerialPort16 }"
                                    FontSize="26"/>
                    <ui:TextBlock Grid.Column="1" Grid.Row="0"
                                  Text="Com 5"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                    <ui:TextBlock Grid.Column="1" Grid.Row="1"
                                  Text="Serial Port Status"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </StatusBar>
    </Grid>
</ui:FluentWindow>

