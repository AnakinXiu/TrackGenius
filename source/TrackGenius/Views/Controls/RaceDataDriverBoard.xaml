<UserControl x:Class="TrackGenius.UI.Views.Controls.RaceDataDriverBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:TrackGenius.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="55" d:DesignWidth="220">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Two-line driver board mirroring the row grid: name on the main level (24pt),
         transponder code on the secondary level (12pt). -->
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Image Width="24" Height="24"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Source="{Binding Flag}"
                   Visibility="{Binding ShowNationality, Converter={StaticResource BoolToVis}}"
                   Stretch="Fill"/>
            <TextBlock Text="{Binding DriverName}"
                       FontSize="24"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding ShowTransponderCode, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="AccessTime20" FontSize="12"/>
            <TextBlock Text="{Binding TransponderCode}"
                       FontSize="12"
                       Opacity="0.7"
                       Padding="6,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
